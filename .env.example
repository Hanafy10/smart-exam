# ==============================================================================
# Smart Exam Proctoring System — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Ports
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 2. Backend Security, JWT & Rate Limiting
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=2
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_MINUTES=1
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. Database & Evidence Storage
# ------------------------------------------------------------------------------
# Local host paths (used when running FastAPI directly on host)
DATABASE_URL=sqlite+aiosqlite:///./smart_exam.db
EVIDENCE_DIR=./evidence

# Docker container paths (used by docker-compose.yml)
DOCKER_DATABASE_URL=sqlite+aiosqlite:////data/smart_exam.db
DOCKER_EVIDENCE_DIR=/app/evidence

# ------------------------------------------------------------------------------
# 4. Initial Database Seed Defaults (backend/seed.py)
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@smartexam.edu
DEFAULT_ADMIN_PASSWORD=Admin@12345678
DEFAULT_ROOM_NAME=Hall 101
DEFAULT_ROOM_BUILDING=Engineering Complex A
DEFAULT_ROOM_CAPACITY=40
DEFAULT_CAMERA_NAME=Ceiling Overhead Cam 1
DEFAULT_CAMERA_DEVICE=0

# ------------------------------------------------------------------------------
# 5. Robot Telemetry Configuration (backend/app/routers/robot.py)
# ------------------------------------------------------------------------------
ROBOT_HEARTBEAT_INTERVAL=30
ROBOT_OFFLINE_TIMEOUT=90

# ------------------------------------------------------------------------------
# 6. Frontend (Next.js) Public Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://192.168.1.9:8000
NEXT_PUBLIC_WS_URL=ws://192.168.1.9:8000/ws/dashboard
NEXT_PUBLIC_DEFAULT_LOGIN_USER=admin
NEXT_PUBLIC_DEFAULT_LOGIN_PASS=Admin@12345678

# ------------------------------------------------------------------------------
# 7. AI Pipeline & Computer Vision Configuration (ai/)
# ------------------------------------------------------------------------------
BACKEND_URL=http://192.168.1.9:8000
DOCKER_BACKEND_URL=http://backend:8000
ROOM_ID=1
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
DISPLAY_GUI=true
DOCKER_DISPLAY_GUI=false
BRIGHTNESS_ALPHA=1.3
BRIGHTNESS_BETA=20
YOLO_MODEL_PATH=yolov8n.pt
PERSON_CONFIDENCE_THRESHOLD=0.5
OBJECT_CONFIDENCE_THRESHOLD=0.4
FACE_CONFIDENCE_THRESHOLD=0.5
SETUP_FRAMES=30
MAX_DISAPPEARED_FRAMES=30
SUSPICIOUS_SCORE_THRESHOLD=10
